EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=2.0.0
EXPO_PUBLIC_BUILD_NUMBER=local
# Crash reporting. Blank here is fine for local work, but a deployed build with
# an empty DSN reports NOTHING — production crashes stay invisible until a user
# reports them by hand. Set this in the Vercel project environment (and in EAS
# for native builds); telemetry.ts turns Sentry on automatically once it is set.
EXPO_PUBLIC_SENTRY_DSN=

# Private Sentry source-map settings. Never prefix these with EXPO_PUBLIC:
# SENTRY_ORG=
# SENTRY_PROJECT=
# EAS secret, never prefix with EXPO_PUBLIC and never commit the real value:
# SENTRY_AUTH_TOKEN=
