{
  "expo": {
    "name": "Orderia",
    "slug": "orderia",
    "version": "1.0.1",
    "scheme": "orderia",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.zwolfe.orderia",
      "infoPlist": {
        "UIBackgroundModes": ["background-processing", "background-fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.zwolfe.orderia",
      "icon": "./assets/icon.png",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Orderia — Garson Sipariş",
      "shortName": "Orderia",
      "lang": "tr",
      "themeColor": "#0F766E",
      "backgroundColor": "#F4F7F6"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5",
          "sounds": ["./assets/notification-sound.wav"],
          "mode": "development"
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8cb6ebf2-d02d-4f26-ba81-e592cc412dff"
      }
    }
  }
}
