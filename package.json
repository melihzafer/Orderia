{
  "name": "orderia",
  "version": "2.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:webpack": "expo start --web --bundler webpack",
    "export:web": "npm run build:web",
    "build:web:bundle": "expo export --platform web",
    "build:web": "npm run build:web:bundle && workbox generateSW workbox-config.cjs && node scripts/verify-pwa-build.mjs",
    "serve:web": "expo serve",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=80",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build:web && npm run test:pwa:only",
    "test:pwa:only": "playwright test --config playwright.pwa.config.ts",
    "test:db": "npx --yes supabase@2.109.1 test db",
    "security:audit": "node scripts/check-security-baseline.mjs && node scripts/check-secrets.mjs",
    "release:env": "node scripts/verify-release-env.mjs",
    "load:staging": "node scripts/load/staging-concurrent-orders.mjs",
    "supabase:start": "npx --yes supabase@2.109.1 start",
    "supabase:stop": "npx --yes supabase@2.109.1 stop --no-backup",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:web",
    "verify:full": "npm run verify && npm run test:e2e && npm run test:pwa:only"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.0.4",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "~6.14.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~53.0.27",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "^13.1.6",
    "expo-file-system": "^18.1.11",
    "expo-font": "~13.3.2",
    "expo-notifications": "~0.31.5",
    "expo-print": "~14.1.4",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "nativewind": "^2.0.11",
    "pdfmake": "^0.2.20",
    "react": "19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-uuid": "^2.0.2",
    "react-native-web": "^0.20.0",
    "react-native-worklets-core": "^1.6.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.20.0",
    "@playwright/test": "^1.62.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "~19.0.10",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "prettier": "^3.9.6",
    "react-native-svg-transformer": "^1.5.1",
    "tailwindcss": "3.3.2",
    "typescript": "~5.8.3",
    "workbox-cli": "^7.4.1"
  },
  "overrides": {
    "react-native": "0.79.6"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@noble/hashes",
          "pdfmake"
        ]
      }
    }
  },
  "private": true
}
